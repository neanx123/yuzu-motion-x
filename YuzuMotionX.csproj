<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>YuzuMotionX</AssemblyName>
    <RootNamespace>YuzuMotionX</RootNamespace>

    <Product>Yuzu Motion X</Product>
    <AssemblyTitle>Yuzu Motion X v1.0</AssemblyTitle>
    <Authors>NeanX</Authors>
    <Company>NeanX</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Description>Yuzu Motion X v1.0 - motion controls for yuzu from a controller, mouse or keyboard, up to 8 players. By NeanX.</Description>

    <!-- One self-contained .exe: no .NET install needed on the target PC -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.ico" LogicalName="icon.ico" />
  </ItemGroup>

</Project>
